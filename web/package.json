{
  "name": "scroll-down-mlb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001 --webpack",
    "build": "next build && cp -r public .next/standalone/public && cp -r .next/static .next/standalone/.next/static",
    "start": "PORT=3001 node .next/standalone/server.js",
    "lint": "eslint",
    "test": "npx playwright test",
    "test:smoke": "npx playwright test --grep @smoke",
    "test:smoke:pr": "npm run build && CI=1 npx playwright test --grep \"@smoke\" --grep-invert \"@live-upstream\"",
    "test:e2e:coverage": "SCROLLDOWN_E2E_COVERAGE=1 npm run build && SCROLLDOWN_E2E_COVERAGE=1 npx playwright test --grep \"@smoke\" --grep-invert \"@live-upstream\"",
    "test:ui": "npx playwright test --ui",
    "test:headed": "npx playwright test --headed",
    "test:unit": "vitest run --passWithNoTests",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.7.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "~9.28",
    "eslint-config-next": "16.2.6",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "monocart-reporter": "^2.11.2",
    "tailwindcss": "^4.3.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
